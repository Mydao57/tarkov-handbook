{
  "name": "@tarkov/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot serving Escape from Tarkov data (items, ammo, quests) from the tarkov.dev GraphQL API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "deploy:global": "tsx src/deploy-commands.ts --global",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarkov/shared": "workspace:*",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13"
  }
}
