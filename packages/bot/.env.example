# --- Discord application credentials ---
# Create an application at https://discord.com/developers/applications
# "Bot" tab -> Reset Token -> copy here
DISCORD_TOKEN=your-bot-token-here
# "General Information" tab -> Application ID
DISCORD_CLIENT_ID=your-application-id-here

# Development: register slash commands instantly on a single test server.
# Right-click your server icon in Discord (with Developer Mode on) -> Copy Server ID.
# Leave empty and run `pnpm deploy:global` to register commands globally (up to ~1h to appear).
DISCORD_GUILD_ID=your-test-server-id-here

# --- tarkov.dev API ---
# Public community GraphQL endpoint, no API key required.
TARKOV_API_URL=https://api.tarkov.dev/graphql

# --- Optional tuning ---
# Per-request timeout for tarkov.dev calls (ms)
TARKOV_HTTP_TIMEOUT_MS=10000
# How long ammo/task lists are cached in memory before refetch (ms). Default 1h.
CACHE_TTL_MS=3600000
# debug | info | warn | error
LOG_LEVEL=info

# --- Internal control API (consumed by the admin web panel) ---
# Off by default. When enabled the bot exposes a small HTTP API bound to
# 127.0.0.1 that the panel process reads for status/metrics and calls for
# actions (clear caches, redeploy commands, toggle runtime flags).
INTERNAL_API_ENABLED=false
# Port for the internal API (localhost only, never expose this publicly).
INTERNAL_API_PORT=4785
# Shared bearer token. Required when INTERNAL_API_ENABLED=true. Must match the
# panel's INTERNAL_API_TOKEN. Generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=
