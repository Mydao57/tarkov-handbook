{
  "name": "@tarkov/panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Admin web panel for the TarkovHandbook Discord bot",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"tsx watch src/index.ts\" \"vite --config client/vite.config.ts\"",
    "build": "tsc && vite build --config client/vite.config.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/oauth2": "^8.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^10.1.3",
    "@tarkov/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "vite": "^8.3.0"
  }
}
