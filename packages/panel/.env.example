# --- Admin web panel ---
# Master switch. The panel process refuses to serve unless this is true.
WEB_PANEL_ENABLED=false
# Port the panel listens on (behind a reverse proxy in production).
WEB_PANEL_PORT=4786
# Address to bind. Leave 0.0.0.0 for local dev; set 127.0.0.1 on a VPS where
# a reverse proxy (Caddy/nginx) is the only thing that should reach it.
WEB_PANEL_HOST=0.0.0.0
# Public origin the browser reaches the panel on. The OAuth2 redirect URI is
# <WEB_PANEL_PUBLIC_URL>/auth/callback -- register that exact URL in the Discord
# developer portal (OAuth2 -> Redirects).
#   dev:  http://localhost:4786
#   prod: https://panel.example.com
WEB_PANEL_PUBLIC_URL=http://localhost:4786

# --- Bot internal control API ---
# Where the bot's internal API listens, and the shared bearer token. Must match
# the bot's INTERNAL_API_PORT / INTERNAL_API_TOKEN.
BOT_INTERNAL_API_URL=http://127.0.0.1:4785
INTERNAL_API_TOKEN=

# --- Discord OAuth2 ---
# Same application as the bot. "OAuth2" tab -> Client ID / Client Secret.
DISCORD_CLIENT_ID=your-application-id-here
DISCORD_OAUTH_CLIENT_SECRET=your-oauth2-client-secret-here

# --- Sessions & access ---
# >= 32 characters. Used to derive the encryption key for the session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated Discord user IDs allowed into the panel. Empty = nobody.
BOT_ADMIN_IDS=

# --- Optional tuning ---
# Max requests per minute per IP.
RATE_LIMIT_MAX=100
# debug | info | warn | error
LOG_LEVEL=info
