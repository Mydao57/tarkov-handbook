# Copy to /etc/tarkov-handbook/bot.env on the VPS.
#   sudo install -m 600 -o tarkov -g tarkov bot.env.example /etc/tarkov-handbook/bot.env
# Then fill the blanks. This file is read by tarkov-bot.service (EnvironmentFile).

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: a guild for instant command deploys. Leave empty to only deploy globally.
DISCORD_GUILD_ID=

# --- tarkov.dev ---
TARKOV_API_URL=https://api.tarkov.dev/graphql
TARKOV_HTTP_TIMEOUT_MS=10000
CACHE_TTL_MS=3600000
LOG_LEVEL=info

# Runtime flag seeds (the panel can change these at runtime; data/flags.json wins once written).
GAME_MODE=regular
FIXTURES_MODE=false
FREEZE_CACHE=false

# --- Internal control API (consumed by the panel over localhost) ---
INTERNAL_API_ENABLED=true
INTERNAL_API_PORT=4785
# openssl rand -hex 32   -- must match panel.env INTERNAL_API_TOKEN
INTERNAL_API_TOKEN=
