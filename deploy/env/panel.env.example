# Copy to /etc/tarkov-handbook/panel.env on the VPS.
#   sudo install -m 600 -o tarkov -g tarkov panel.env.example /etc/tarkov-handbook/panel.env
# Then fill the blanks. This file is read by tarkov-panel.service (EnvironmentFile).

WEB_PANEL_ENABLED=true
# Bind localhost only; Caddy/nginx on the same box is the sole entry point.
WEB_PANEL_HOST=127.0.0.1
WEB_PANEL_PORT=4786
# Public URL. The OAuth2 redirect is <this>/auth/callback -- register
# https://tarkov-handbook.example.com/auth/callback in the Discord portal.
WEB_PANEL_PUBLIC_URL=https://tarkov-handbook.example.com

# --- Bot internal API (same box) ---
BOT_INTERNAL_API_URL=http://127.0.0.1:4785
# Must match bot.env INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=

# --- Discord OAuth2 (same application as the bot) ---
DISCORD_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# --- Sessions & access ---
# openssl rand -hex 32
SESSION_SECRET=
# Comma-separated Discord user IDs allowed in. Empty = nobody.
BOT_ADMIN_IDS=

RATE_LIMIT_MAX=100
LOG_LEVEL=info
